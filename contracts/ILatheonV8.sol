pragma solidity 0.8.39;

// Shared interfaces and types of the V8 contracts (docs/v8-design.md). Testnet only, not audited.

/// @notice Groth16 verifier generated by snarkjs for circuits/withdraw_v6.circom.
///         Public signals, in order: [root, nullifierHash, ctx, extDataHash].
interface IWithdrawVerifierV6 {
    function verifyProof(
        uint256[2] calldata _pA,
        uint256[2][2] calldata _pB,
        uint256[2] calldata _pC,
        uint256[4] calldata _pubSignals
    ) external view returns (bool);
}

/// @notice A Groth16 proof as snarkjs exports it for Solidity.
struct ProofV8 {
    uint256[2] pA;
    uint256[2][2] pB;
    uint256[2] pC;
}

/// @notice What a withdrawal pays out, bound into the proof through
///         extDataHash = keccak256(abi.encode(recipient, relayer, fee, paymentRef, destChainId)) mod p.
/// @dev `paymentRef` (the payment reference of §5) is filled in every withdrawal: a payment reference (for example the hash of an invoice number and a
///      salt) or random bytes when unused, so withdrawals with and without a reference look alike (§5, §13 item 2).
///      `destChainId` must equal block.chainid in V8 (§7).
struct ExtDataV8 {
    address recipient;
    address relayer;
    uint256 fee;
    bytes32 paymentRef;
    uint256 destChainId;
}

interface ILatheonPoolV8Native {
    function token() external view returns (address);
    function DENOMINATION() external view returns (uint256);
    function nullifierHashes(uint256 nullifierHash) external view returns (bool);
    function deposit(uint256 commitment) external payable;
    function withdraw(ProofV8 calldata proof, uint256 root, uint256 nullifierHash, ExtDataV8 calldata ext) external;
}
