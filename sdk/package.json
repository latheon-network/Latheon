{
  "name": "@latheon/sdk",
  "version": "0.2.0",
  "description": "JavaScript SDK for Latheon's V7 shielded pools and distribution router: notes and master keys, 20-level Merkle paths, withdraw_v5 proofs, deposits, withdraw and withdrawMany (recipient, relayer and fee bound into the proof).",
  "main": "src/index.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/unit.js && node test/proof.js",
    "test:unit": "node test/unit.js",
    "test:proof": "node test/proof.js",
    "test:e2e": "node test/e2e.js",
    "test:all": "node test/unit.js && node test/proof.js && node test/e2e.js"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "poseidon-lite": "^0.3.0"
  },
  "peerDependencies": {
    "snarkjs": "^0.7.6"
  },
  "peerDependenciesMeta": {
    "snarkjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "ganache": "7.9.2",
    "snarkjs": "0.7.6",
    "solc": "0.8.37"
  },
  "keywords": ["latheon", "zero-knowledge", "privacy", "ethereum", "merkle-tree", "groth16"],
  "repository": {
    "type": "git",
    "url": "https://github.com/latheon-network/latheon.git"
  }
}
